---
import type { HighEndDentalChairDetail } from '@data/highEndDentalChairDetails';
interface Props { product: HighEndDentalChairDetail }
const { product } = Astro.props;
---
{product.cases.length > 0 && <section class="b100-case-band" id="case">
  <div class="container"><div class="b100-content-narrow">
    <div class="b100-case-heading"><div><span class="b100-eyebrow">Case</span><h2>{product.caseHeading}</h2></div>{product.caseIntroduction && <p>{product.caseIntroduction}</p>}</div>
    {product.caseDisclosure && <p class="b100-case-disclosure">{product.caseDisclosure}</p>}
    {product.caseCaptions?.length ? <div class="wood-case-layout">
      <figure><img src={product.cases[0].src} alt={product.cases[0].alt} width={product.cases[0].width} height={product.cases[0].height} loading="lazy" decoding="async" /></figure>
      <div class="wood-case-copy">{product.caseCaptions.map(item => <article><h3>{item.title}</h3><p>{item.description}</p></article>)}</div>
    </div> : <div class:list={["wood-case-grid", { "is-three-up": product.cases.length === 3, "is-portrait": product.slug === "tj-dc600" }]}>{product.cases.map(item => <figure><img src={item.src} alt={item.alt} width={item.width} height={item.height} loading="lazy" decoding="async" /><figcaption><strong>{item.title}</strong><span>{item.description}</span></figcaption></figure>)}</div>}
  </div></div>
</section>}
<style>
  .wood-case-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px}
  .wood-case-grid.is-three-up{grid-template-columns:repeat(3,minmax(0,1fr))}
  .wood-case-grid figure{margin:0;min-width:0}
  .wood-case-grid img{display:block;width:100%;height:auto;aspect-ratio:4/3;object-fit:cover;border-radius:10px}
  .wood-case-grid.is-three-up img{aspect-ratio:1/1;background:#f4f6f8;object-fit:contain}
  .wood-case-grid.is-three-up.is-portrait img{aspect-ratio:3/4}
  .wood-case-grid figcaption{display:grid;gap:5px;padding-top:12px;color:#52616b;line-height:1.5}
  .wood-case-grid strong{color:#20313e}
  .wood-case-layout{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);align-items:center;gap:clamp(28px,4vw,64px)}
  .wood-case-layout figure{margin:0;min-width:0}
  .wood-case-layout img{display:block;width:100%;height:auto;border-radius:12px}
  .wood-case-copy{min-width:0}
  .wood-case-copy article+article{margin-top:26px;padding-top:26px;border-top:1px solid #dfe6ed}
  .wood-case-copy h3{color:#0f172a;font-size:19px;font-weight:500;line-height:1.35;margin:0 0 10px}
  .wood-case-copy p{color:#64748b;font-size:16px;line-height:1.7;margin:0}
  @media(max-width:900px){.wood-case-grid.is-three-up{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:700px){.wood-case-grid,.wood-case-grid.is-three-up,.wood-case-layout{grid-template-columns:1fr}}
</style>

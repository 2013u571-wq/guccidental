---
import "../../styles.css";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import FloatingContactCta from "@components/ui/FloatingContactCta.astro";
import { alternateLinks, getDirection, localizedPath, withoutLanguage, type LanguageCode } from "@lib/i18n";
import { productSeoForPath, type SeoProduct } from "@lib/seoCatalog";
import { site } from "@data/site";

type Props = {
  title: string;
  description?: string;
  lang: LanguageCode;
  pathname: string;
  bodyClass?: string;
  preloadImages?: Array<{ href: string; media?: string }>;
  seoProduct?: SeoProduct;
  socialImage?: string;
};

const { title, description = site.description, lang, pathname, bodyClass, preloadImages = [], seoProduct, socialImage } = Astro.props;
const direction = getDirection(lang);
const contentLanguage = "en";
const canonicalPath = lang === "en" ? pathname : localizedPath("en", withoutLanguage(pathname));
const links = alternateLinks(canonicalPath).filter((link) => link.lang === contentLanguage);
const pageTitle = title === site.name ? title : `${title} | ${site.name}`;
const canonicalUrl = new URL(canonicalPath, site.url).href;
const product = seoProduct || productSeoForPath(pathname);
const pageDescription = product && !description.toLowerCase().includes(product.model.toLowerCase())
  ? `${product.model} ${product.category}. ${description}`
  : description;
const pageImage = new URL(socialImage || product?.image || "https://media.guccidental.com/images/guccidental-factory-office-building-card.jpg", site.url).href;
const pageImageAlt = product ? `${product.name} product image` : "Guccidental dental equipment and clinic solutions";
const organizationId = `${site.url}/#organization`;
const websiteId = `${site.url}/#website`;
const productId = `${canonicalUrl}#product`;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Organization", "@id": organizationId, name: site.companyName, url: site.url, logo: "https://media.guccidental.com/assets/guccidental-logo.png", email: site.email },
    { "@type": "WebSite", "@id": websiteId, name: site.name, url: site.url, publisher: { "@id": organizationId }, inLanguage: contentLanguage },
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: pageTitle,
      description: pageDescription,
      inLanguage: contentLanguage,
      isPartOf: { "@id": websiteId },
      primaryImageOfPage: { "@type": "ImageObject", url: pageImage },
      ...(product ? { about: { "@id": productId } } : {}),
    },
    ...(product ? [{
      "@type": "Product",
      "@id": productId,
      name: product.name,
      description: pageDescription,
      url: canonicalUrl,
      category: product.category,
      sku: product.model,
      ...(product.image ? { image: new URL(product.image, site.url).href } : {}),
      ...(product.specs?.length ? { additionalProperty: product.specs.filter((spec) => spec.value && !/to confirm|pending/i.test(spec.value)).map((spec) => ({ "@type": "PropertyValue", name: spec.label, value: spec.value })) } : {}),
    }] : []),
  ],
};
---

<!doctype html>
<html lang={contentLanguage} dir={direction}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <meta name="robots" content={lang === "en" ? "index, follow, max-image-preview:large" : "noindex, follow"} />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://media.guccidental.com" crossorigin />
    {preloadImages.map((image) => <link rel="preload" as="image" href={image.href} type="image/webp" media={image.media} fetchpriority="high" />)}
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@300;400;500;600;700&family=Newsreader:wght@500;600;700&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/png" sizes="32x32" href="https://media.guccidental.com/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="https://media.guccidental.com/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonicalUrl} />
    {links.map((link) => <link rel="alternate" hreflang={link.lang} href={new URL(link.href, site.url).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(links.find((link) => link.lang === "en")?.href || "/en/", site.url).href} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={pageImage} />
    <meta property="og:image:alt" content={pageImageAlt} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={pageImage} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")} />
  </head>
  <body class:list={["min-h-screen bg-surface-white text-ink-primary antialiased", bodyClass]}>
    <Header lang={lang} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    <FloatingContactCta lang={lang} />
  </body>
</html>

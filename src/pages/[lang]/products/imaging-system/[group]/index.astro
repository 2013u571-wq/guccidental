---
import BaseLayout from "@components/layout/BaseLayout.astro";
import Button from "@components/ui/Button.astro";
import InquiryCta from "@components/ui/InquiryCta.astro";
import catalog from "@data/imagingModels.json";
import { imagingGroups } from "@data/imagingGroups";
import { getLanguage, languages, localizedPath } from "@lib/i18n";

export function getStaticPaths() {
  return languages.flatMap((language) => imagingGroups.map((group) => ({
    params: { lang: language.code, group: group.slug }
  })));
}

const lang = getLanguage(Astro.params.lang);
const group = imagingGroups.find((item) => item.slug === Astro.params.group)!;
const products = catalog.filter((item) => item.groupSlug === group.slug);
const detailHref = (slug: string) => localizedPath(lang, "/products/imaging-system/" + group.slug + "/" + slug + "/");
const inquiryHref = (model: string) => localizedPath(lang, "/contact/?message=" + encodeURIComponent("I'm interested in the " + model + " imaging product."));
---
<BaseLayout title={group.name + " — " + products.length + " Products"} description={group.summary} lang={lang} pathname={Astro.url.pathname}>
  <section class="chair-tier-hero scaler-category-hero">
    <div class="container">
      <nav class="chair-tier-breadcrumb" aria-label="Breadcrumb"><a href={localizedPath(lang, "/products/")}>Products</a><span aria-hidden="true">/</span><a href={localizedPath(lang, "/products/imaging-system/")}>Imaging System</a><span aria-hidden="true">/</span><span aria-current="page">{group.name}</span></nav>
      <p class="chair-tier-eyebrow">Imaging System</p>
      <h1>{group.name}</h1>
      <p class="chair-tier-summary">{group.summary} Browse {products.length} products.</p>
      <Button href={localizedPath(lang, "/contact/?category=imaging-system-" + group.slug)}>Ask for Quote</Button>
      <nav class="tier-switch scaler-tier-switch imaging-group-switch" aria-label="Imaging product categories">
        {imagingGroups.map((item) => <a class:list={["imaging-group-link", { "is-current": item.slug === group.slug }]} href={localizedPath(lang, "/products/imaging-system/" + item.slug + "/")} aria-current={item.slug === group.slug ? "page" : undefined}>{item.name} <span>{catalog.filter((product) => product.groupSlug === item.slug).length}</span></a>)}
      </nav>
    </div>
  </section>
  <section class="chair-tier-models scaler-category-models" id="models"><div class="container"><div class="tier-group-rows">
    {products.map((model) => <article class="tier-model-row">
      <a class="tier-model-thumb handpiece-model-thumb" href={detailHref(model.slug)} aria-label={"View " + model.model + " details"}><img src={model.thumbnail} alt={model.model + " " + group.name.toLowerCase() + " product photo"} width="112" height="86" loading="lazy" decoding="async" /></a>
      <div class="tier-model-meta"><a class="tier-model-name" href={detailHref(model.slug)}>{model.model}</a><p>{model.subtitle}</p></div>
      <div class="tier-model-actions"><a class="tier-model-details" href={detailHref(model.slug)}>Details <span aria-hidden="true">→</span></a><a class="tier-model-inquiry" href={inquiryHref(model.model)}>Inquiry</a></div>
    </article>)}
  </div></div></section>
  <InquiryCta lang={lang} title={"Request " + group.name + " Product Details"} />
</BaseLayout>

---
import BaseLayout from "@components/layout/BaseLayout.astro";
import Button from "@components/ui/Button.astro";
import InquiryCta from "@components/ui/InquiryCta.astro";
import catalog from "@data/surgicalInstrumentModels.json";
import { getLanguage, languages, localizedPath } from "@lib/i18n";

export function getStaticPaths() {
  return languages.map((language) => ({ params: { lang: language.code } }));
}

const lang = getLanguage(Astro.params.lang);
const groups = [...new Set(catalog.map((item) => item.group))].map((name) => ({
  name,
  id: name.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, ""),
  models: catalog.filter((item) => item.group === name),
}));
const detailHref = (slug: string) => localizedPath(lang, `/products/surgical-instruments/${slug}/`);
const inquiryHref = (model: string) => localizedPath(lang, `/contact/?message=${encodeURIComponent(`I'm interested in the ${model} surgical instruments catalog product.`)}`);
---
<BaseLayout title={`Surgical Instruments — ${catalog.length} Products`} description={`Browse ${catalog.length} surgical instruments and related clinical products, including magnification, lighting, restorative accessories and consumables.`} lang={lang} pathname={Astro.url.pathname}>
  <section class="chair-tier-hero">
    <div class="container">
      <nav class="chair-tier-breadcrumb" aria-label="Breadcrumb">
        <a href={localizedPath(lang, "/products/")}>Products</a><span aria-hidden="true">/</span>
        <span aria-current="page">Surgical Instruments</span>
      </nav>
      <p class="chair-tier-eyebrow">Dental Products</p>
      <h1>Surgical Instruments</h1>
      <p class="chair-tier-summary">Explore {catalog.length} surgical instruments and related clinical products, from chairside tools and consumables to magnification, lighting and accessories.</p>
      <Button href={localizedPath(lang, "/contact/?category=surgical-instruments")}>Ask for Quote</Button>
    </div>
  </section>
  <section class="chair-tier-models" id="models">
    <div class="container">
      <nav class="tier-series-jump" aria-label="Surgical instrument product groups">
        <span class="tier-series-jump-label">Jump to</span>
        {groups.map((group) => <a href={`#${group.id}`}>{group.name}</a>)}
      </nav>
      <div class="tier-model-groups">
        {groups.map((group) => <section class="tier-model-group" id={group.id} aria-labelledby={`${group.id}-title`}>
          <header class="tier-group-head"><h2 id={`${group.id}-title`}>{group.name}</h2><span class="tier-group-count">{group.models.length} {group.models.length === 1 ? "product" : "products"}</span><span class="tier-group-rule" aria-hidden="true"></span></header>
          <div class="tier-group-rows">
            {group.models.map((model) => <article class="tier-model-row">
              <a class="tier-model-thumb handpiece-model-thumb" href={detailHref(model.slug)} aria-label={`View ${model.model} details`}><img src={model.thumbnail} alt={`${model.model} dental surgical instrument photo`} width="112" height="86" loading="lazy" decoding="async" /></a>
              <div class="tier-model-meta"><a class="tier-model-name" href={detailHref(model.slug)}>{model.model}</a><p>{model.subtitle}</p></div>
              <div class="tier-model-actions"><a class="tier-model-details" href={detailHref(model.slug)}>Details <span aria-hidden="true">→</span></a><a class="tier-model-inquiry" href={inquiryHref(model.model)}>Inquiry</a></div>
            </article>)}
          </div>
        </section>)}
      </div>
    </div>
  </section>
  <InquiryCta lang={lang} title="Request Surgical Instrument Details" />
</BaseLayout>

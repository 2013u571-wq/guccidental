---
import BaseLayout from "@components/layout/BaseLayout.astro";
import Button from "@components/ui/Button.astro";
import InquiryCta from "@components/ui/InquiryCta.astro";
import catalog from "@data/orthodonticsModels.json";
import { getLanguage, languages, localizedPath } from "@lib/i18n";

export function getStaticPaths() {
  return languages.map((language) => ({ params: { lang: language.code } }));
}

const lang = getLanguage(Astro.params.lang);
const detailHref = (slug: string) => localizedPath(lang, `/products/orthodontics/${slug}/`);
const inquiryHref = (model: string) => localizedPath(lang, `/contact/?message=${encodeURIComponent(`I'm interested in the ${model} orthodontic product.`)}`);
---
<BaseLayout title="Orthodontics — 5 Products" description="Explore five orthodontic and related chairside products, including brackets, matrix bands, pediatric crowns, and forming slices." lang={lang} pathname={Astro.url.pathname}>
  <section class="chair-tier-hero">
    <div class="container">
      <nav class="chair-tier-breadcrumb" aria-label="Breadcrumb">
        <a href={localizedPath(lang, "/products/")}>Products</a><span aria-hidden="true">/</span>
        <span aria-current="page">Orthodontics</span>
      </nav>
      <p class="chair-tier-eyebrow">Dental Products</p>
      <h1>Orthodontics</h1>
      <p class="chair-tier-summary">Brackets, matrix bands, pediatric crowns, and forming slices for orthodontic and related chairside workflows. Explore five available products.</p>
      <Button href={localizedPath(lang, "/contact/?category=orthodontics")}>Ask for Quote</Button>
    </div>
  </section>
  <section class="chair-tier-models" id="models">
    <div class="container">
      <div class="tier-model-groups">
        <section class="tier-model-group" aria-labelledby="orthodontics-products-title">
          <header class="tier-group-head"><h2 id="orthodontics-products-title">Available Products</h2><span class="tier-group-count">5 products</span><span class="tier-group-rule" aria-hidden="true"></span></header>
          <div class="tier-group-rows">
            {catalog.map((model) => <article class="tier-model-row">
              <a class="tier-model-thumb handpiece-model-thumb" href={detailHref(model.slug)} aria-label={`View ${model.model} details`}><img src={model.thumbnail} alt={`${model.model} orthodontic product photo`} width="112" height="86" loading="lazy" decoding="async" /></a>
              <div class="tier-model-meta"><a class="tier-model-name" href={detailHref(model.slug)}>{model.model}</a><p>{model.subtitle}</p></div>
              <div class="tier-model-actions"><a class="tier-model-details" href={detailHref(model.slug)}>Details <span aria-hidden="true">→</span></a><a class="tier-model-inquiry" href={inquiryHref(model.model)}>Inquiry</a></div>
            </article>)}
          </div>
        </section>
      </div>
    </div>
  </section>
  <InquiryCta lang={lang} title="Request Orthodontics Product Details" />
</BaseLayout>

---
import BaseLayout from "@components/layout/BaseLayout.astro";
import Button from "@components/ui/Button.astro";
import InquiryCta from "@components/ui/InquiryCta.astro";
import catalog from "@data/teachingModels.json";
import { getLanguage, languages, localizedPath } from "@lib/i18n";

export function getStaticPaths() {
  return languages.map((language) => ({ params: { lang: language.code } }));
}

const lang = getLanguage(Astro.params.lang);
const groups = [...new Set(catalog.map((item) => item.group))].map((name) => ({
  name,
  id: name.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, ""),
  models: catalog.filter((item) => item.group === name),
}));
const detailHref = (slug: string) => localizedPath(lang, `/products/teaching-model/${slug}/`);
const inquiryHref = (model: string) => localizedPath(lang, `/contact/?message=${encodeURIComponent(`I'm interested in the ${model} teaching model.`)}`);
---
<BaseLayout title={`Teaching Model — ${catalog.length} Products`} description={`Browse ${catalog.length} dental teaching models for anatomy, orthodontics, implants, restoration and patient education.`} lang={lang} pathname={Astro.url.pathname}>
  <section class="chair-tier-hero">
    <div class="container">
      <nav class="chair-tier-breadcrumb" aria-label="Breadcrumb">
        <a href={localizedPath(lang, "/products/")}>Products</a><span aria-hidden="true">/</span>
        <span aria-current="page">Teaching Model</span>
      </nav>
      <p class="chair-tier-eyebrow">Dental Products</p>
      <h1>Teaching Model</h1>
      <p class="chair-tier-summary">Explore {catalog.length} dental teaching models for anatomy, orthodontics, implants, restoration and patient education.</p>
      <Button href={localizedPath(lang, "/contact/?category=teaching-model")}>Ask for Quote</Button>
    </div>
  </section>
  <section class="chair-tier-models" id="models">
    <div class="container">
      <nav class="tier-series-jump" aria-label="Teaching model product groups">
        <span class="tier-series-jump-label">Jump to</span>
        {groups.map((group) => <a href={`#${group.id}`}>{group.name}</a>)}
      </nav>
      <div class="tier-model-groups">
        {groups.map((group) => <section class="tier-model-group" id={group.id} aria-labelledby={`${group.id}-title`}>
          <header class="tier-group-head"><h2 id={`${group.id}-title`}>{group.name}</h2><span class="tier-group-count">{group.models.length} {group.models.length === 1 ? "product" : "products"}</span><span class="tier-group-rule" aria-hidden="true"></span></header>
          <div class="tier-group-rows">
            {group.models.map((model) => <article class="tier-model-row">
              <a class="tier-model-thumb handpiece-model-thumb" href={detailHref(model.slug)} aria-label={`View ${model.model} details`}><img src={model.thumbnail} alt={`${model.model} dental teaching model photo`} width="112" height="86" loading="lazy" decoding="async" /></a>
              <div class="tier-model-meta"><a class="tier-model-name" href={detailHref(model.slug)}>{model.model}</a><p>{model.subtitle}</p></div>
              <div class="tier-model-actions"><a class="tier-model-details" href={detailHref(model.slug)}>Details <span aria-hidden="true">→</span></a><a class="tier-model-inquiry" href={inquiryHref(model.model)}>Inquiry</a></div>
            </article>)}
          </div>
        </section>)}
      </div>
    </div>
  </section>
  <section class="b100-downloads-band handpiece-resource-band" id="product-resources"><div class="container"><div class="b100-resource-card"><div class="b100-resource-icon" aria-hidden="true"><svg viewBox="0 0 32 32"><path d="M9 4h10l5 5v19H9z"></path><path d="M19 4v6h6M13 16h7M13 21h7"></path></svg></div><div><span class="b100-eyebrow">Product resources</span><h2>Teaching Model E-catalog</h2><p>View or download the supplied Teaching Model catalog.</p></div><div class="b100-resource-actions"><a class="b100-btn b100-btn-primary" href="/downloads/teaching-model/e-catalog.pdf" download>Download E-catalog <span aria-hidden="true">↓</span></a><span class="b100-resource-meta">PDF · 44.8 MB</span></div></div></div></section>
  <InquiryCta lang={lang} title="Request Teaching Model Details" />
</BaseLayout>

---
import BaseLayout from "@components/layout/BaseLayout.astro";
import Button from "@components/ui/Button.astro";
import InquiryCta from "@components/ui/InquiryCta.astro";
import catalog from "@data/handpieceModels.json";
import { getLanguage, languages, localizedPath } from "@lib/i18n";

type Speed = "high-speed" | "low-speed";
const speeds: Speed[] = ["high-speed", "low-speed"];
const labels: Record<Speed, string> = { "high-speed": "High Speed", "low-speed": "Low Speed" };
const descriptions: Record<Speed, string> = {
  "high-speed": "Turbine handpieces for precise chairside preparation and restorative procedures.",
  "low-speed": "Motors, contra angles and straight handpieces for finishing, polishing and specialist procedures."
};
export function getStaticPaths() {
  return languages.flatMap((language) => [undefined, "high-speed", "low-speed"].map((speed) => ({ params: { lang: language.code, speed } })));
}
const lang = getLanguage(Astro.params.lang);
if (!Astro.params.speed) return Astro.redirect(localizedPath(lang, "/products/dental-handpiece/high-speed/"));
const speed: Speed = Astro.params.speed === "low-speed" ? "low-speed" : "high-speed";
const models = catalog.filter((item) => item.speed === speed);
const groups = [...new Set(models.map((item) => item.group))].map((name) => ({
  name,
  id: name.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, ""),
  models: models.filter((item) => item.group === name)
}));
const detailHref = (slug: string) => localizedPath(lang, `/products/dental-handpiece/${speed}/${slug}/`);
const inquiryHref = (model: string) => localizedPath(lang, `/contact/?message=${encodeURIComponent(`I'm interested in the ${model} dental handpiece.`)}`);
---
<BaseLayout title={`${labels[speed]} Dental Handpieces — ${models.length} Models`} description={`${descriptions[speed]} ${models.length} models available.`} lang={lang} pathname={Astro.url.pathname}>
  <section class="chair-tier-hero">
    <div class="container">
      <nav class="chair-tier-breadcrumb" aria-label="Breadcrumb">
        <a href={localizedPath(lang, "/products/")}>Products</a><span aria-hidden="true">/</span>
        <a href={localizedPath(lang, "/products/dental-handpiece/")}>Dental Handpiece</a><span aria-hidden="true">/</span>
        <span aria-current="page">{labels[speed]}</span>
      </nav>
      <p class="chair-tier-eyebrow">Dental Handpiece</p>
      <h1>{labels[speed]} Dental Handpieces</h1>
      <p class="chair-tier-summary">{descriptions[speed]} {models.length} models available.</p>
      <Button href={localizedPath(lang, "/contact/?category=dental-handpiece")}>Ask for Quote</Button>
      <nav class="tier-switch" aria-label="Dental handpiece speeds">
        {speeds.map((item) => <a href={localizedPath(lang, `/products/dental-handpiece/${item}/`)} aria-current={item === speed ? "page" : undefined}>{labels[item]} <span>{catalog.filter((model) => model.speed === item).length}</span></a>)}
      </nav>
    </div>
  </section>
  <section class="chair-tier-models">
    <div class="container">
      <nav class="tier-series-jump" aria-label={`${labels[speed]} handpiece groups`}>
        <span class="tier-series-jump-label">Jump to</span>
        {groups.map((group) => <a href={`#${group.id}`}>{group.name}</a>)}
      </nav>
      <div class="tier-model-groups">
        {groups.map((group) => <section class="tier-model-group" id={group.id} aria-labelledby={`${group.id}-title`}>
          <header class="tier-group-head"><h2 id={`${group.id}-title`}>{group.name}</h2><span class="tier-group-count">{group.models.length} models</span><span class="tier-group-rule" aria-hidden="true"></span></header>
          <div class="tier-group-rows">
            {group.models.map((model) => <article class="tier-model-row">
              <a class="tier-model-thumb handpiece-model-thumb" href={detailHref(model.slug)} aria-label={`View ${model.model} details`}><img src={model.thumbnail} alt={`${model.model} dental handpiece photo`} width="112" height="86" loading="lazy" decoding="async" /></a>
              <div class="tier-model-meta"><a class="tier-model-name" href={detailHref(model.slug)}>{model.model}</a><p>{model.title}</p></div>
              <div class="tier-model-actions"><a class="tier-model-details" href={detailHref(model.slug)}>Details <span aria-hidden="true">→</span></a><a class="tier-model-inquiry" href={inquiryHref(model.model)}>Inquiry</a></div>
            </article>)}
          </div>
        </section>)}
      </div>
    </div>
  </section>
  <InquiryCta lang={lang} title={`Request ${labels[speed]} Dental Handpiece Details`} />
</BaseLayout>

---
import BaseLayout from "@components/layout/BaseLayout.astro";
import Button from "@components/ui/Button.astro";
import InquiryCta from "@components/ui/InquiryCta.astro";
import catalog from "@data/scalerModels.json";
import { getLanguage, languages, localizedPath } from "@lib/i18n";

export function getStaticPaths() {
  return languages.map((language) => ({ params: { lang: language.code } }));
}

const lang = getLanguage(Astro.params.lang);
const groupDefinitions = [
  { name: "Ultrasonic Scaler", id: "ultrasonic-scaler" },
  { name: "Air Polisher", id: "air-polisher" },
  { name: "Accessories & Consumables", id: "accessories-consumables" },
] as const;
const groups = groupDefinitions.map((group) => ({
  ...group,
  models: catalog.filter((item) => item.groupSlug === group.id),
}));
const detailHref = (slug: string) => localizedPath(lang, `/products/ultrasonic-scaler-light-cure/scaler/${slug}/`);
const inquiryHref = (model: string) => localizedPath(lang, `/contact/?message=${encodeURIComponent(`I'm interested in the ${model} scaler product.`)}`);
---
<BaseLayout title={`Ultrasonic Scaler — ${catalog.length} Products`} description={`Browse ${catalog.length} ultrasonic scalers, air polishers, scaler accessories and consumables.`} lang={lang} pathname={Astro.url.pathname}>
  <section class="chair-tier-hero scaler-category-hero">
    <div class="container">
      <nav class="chair-tier-breadcrumb" aria-label="Breadcrumb">
        <a href={localizedPath(lang, "/products/")}>Products</a><span aria-hidden="true">/</span>
        <span aria-current="page">Ultrasonic Scaler</span>
      </nav>
      <p class="chair-tier-eyebrow">Treatment Equipment</p>
      <h1>Ultrasonic Scaler</h1>
      <p class="chair-tier-summary">Explore {catalog.length} products across ultrasonic scaling, air polishing and chairside accessories.</p>
      <Button href={localizedPath(lang, "/contact/?category=ultrasonic-scaler")}>Ask for Quote</Button>
      <div class="tier-switch scaler-tier-switch" role="tablist" aria-label="Scaler product categories">
        {groups.map((group, index) => <button type="button" role="tab" id={`scaler-tab-${group.id}`} aria-controls={`scaler-panel-${group.id}`} aria-selected={index === 0 ? "true" : "false"} tabindex={index === 0 ? 0 : -1} data-scaler-tab data-group={group.id}>{group.name} <span>{group.models.length}</span></button>)}
      </div>
    </div>
  </section>
  <section class="chair-tier-models scaler-category-models" id="models">
    <div class="container">
      {groups.map((group, index) => <section class="scaler-tab-panel" id={`scaler-panel-${group.id}`} role="tabpanel" aria-labelledby={`scaler-tab-${group.id}`} data-scaler-panel data-group={group.id} hidden={index !== 0}>
        <div class="tier-group-rows">
          {group.models.map((model) => <article class="tier-model-row">
            <a class="tier-model-thumb handpiece-model-thumb" href={detailHref(model.slug)} aria-label={`View ${model.model} details`}><img src={model.thumbnail} alt={`${model.model} ultrasonic scaler photo`} width="112" height="86" loading="lazy" decoding="async" /></a>
            <div class="tier-model-meta"><a class="tier-model-name" href={detailHref(model.slug)}>{model.model}</a><p>{model.subtitle}</p></div>
            <div class="tier-model-actions"><a class="tier-model-details" href={detailHref(model.slug)}>Details <span aria-hidden="true">→</span></a><a class="tier-model-inquiry" href={inquiryHref(model.model)}>Inquiry</a></div>
          </article>)}
        </div>
      </section>)}
    </div>
  </section>
  <InquiryCta lang={lang} title="Request Scaler Product Details" />
</BaseLayout>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>("[data-scaler-tab]")];
  const panels = [...document.querySelectorAll<HTMLElement>("[data-scaler-panel]")];
  const activate = (id: string, focus = false) => {
    const selected = tabs.find((tab) => tab.dataset.group === id);
    if (!selected) return;
    tabs.forEach((tab) => {
      const active = tab === selected;
      tab.setAttribute("aria-selected", String(active));
      tab.tabIndex = active ? 0 : -1;
    });
    panels.forEach((panel) => { panel.hidden = panel.dataset.group !== id; });
    if (focus) selected.focus();
  };
  tabs.forEach((tab, index) => {
    tab.addEventListener("click", () => {
      activate(tab.dataset.group || "");
      history.replaceState(null, "", `#${tab.dataset.group}`);
    });
    tab.addEventListener("keydown", (event) => {
      const next = event.key === "ArrowRight" ? (index + 1) % tabs.length : event.key === "ArrowLeft" ? (index - 1 + tabs.length) % tabs.length : event.key === "Home" ? 0 : event.key === "End" ? tabs.length - 1 : -1;
      if (next < 0) return;
      event.preventDefault();
      const id = tabs[next].dataset.group || "";
      activate(id, true);
      history.replaceState(null, "", `#${id}`);
    });
  });
  const activateFromHash = () => activate(location.hash.slice(1));
  window.addEventListener("hashchange", activateFromHash);
  activateFromHash();
</script>

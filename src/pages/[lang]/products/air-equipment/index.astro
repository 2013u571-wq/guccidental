---
import BaseLayout from "@components/layout/BaseLayout.astro";
import Button from "@components/ui/Button.astro";
import InquiryCta from "@components/ui/InquiryCta.astro";
import catalog from "@data/airEquipmentModels.json";
import { getLanguage, languages, localizedPath } from "@lib/i18n";

export function getStaticPaths() {
  return languages.map((language) => ({ params: { lang: language.code } }));
}

const lang = getLanguage(Astro.params.lang);
const visibleCatalog = catalog.filter((item) => !item.hidden);
const definitions = [
  { name: "Air Compressor", id: "air-compressor" },
  { name: "Suction Unit", id: "suction-unit" },
];
const groups = definitions.map((group) => ({ ...group, models: visibleCatalog.filter((item) => item.groupSlug === group.id) }));
const coverOverrides: Record<string, string> = {
  "air-100-air-1000": "/images/products/air-equipment/air-100-air-1000/air-100-air-1000-category-cover.webp",
  "gs-20": "/images/products/air-equipment/gs-20/gs-20-category-cover.webp",
};
const originalCoverSlugs = new Set(["ga-163", "ga-165xy"]);
const detailHref = (slug: string) => localizedPath(lang, `/products/air-equipment/${slug}/`);
const inquiryHref = (model: string) => localizedPath(lang, `/contact/?message=${encodeURIComponent(`I'm interested in the ${model} air equipment product.`)}`);
---
<BaseLayout title={`Air Equipment — ${visibleCatalog.length} Products`} description={`Browse ${visibleCatalog.length} dental air compressors and suction units.`} lang={lang} pathname={Astro.url.pathname}>
  <section class="chair-tier-hero scaler-category-hero">
    <div class="container">
      <nav class="chair-tier-breadcrumb" aria-label="Breadcrumb"><a href={localizedPath(lang, "/products/")}>Products</a><span aria-hidden="true">/</span><span aria-current="page">Air Equipment</span></nav>
      <p class="chair-tier-eyebrow">Treatment Equipment</p>
      <h1>Air Equipment</h1>
      <p class="chair-tier-summary">Explore {visibleCatalog.length} dental air compressors and suction units.</p>
      <Button href={localizedPath(lang, "/contact/?category=air-equipment")}>Ask for Quote</Button>
      <div class="tier-switch scaler-tier-switch" role="tablist" aria-label="Air equipment categories">
        {groups.map((group, index) => <button type="button" role="tab" id={`air-tab-${group.id}`} aria-controls={`air-panel-${group.id}`} aria-selected={index === 0 ? "true" : "false"} tabindex={index === 0 ? 0 : -1} data-air-tab data-group={group.id}>{group.name} <span>{group.models.length}</span></button>)}
      </div>
    </div>
  </section>
  <section class="chair-tier-models scaler-category-models" id="models"><div class="container">
    {groups.map((group, index) => <section class="scaler-tab-panel" id={`air-panel-${group.id}`} role="tabpanel" aria-labelledby={`air-tab-${group.id}`} data-air-panel data-group={group.id} hidden={index !== 0}>
      <div class="tier-group-rows">
        {group.models.map((model) => <article class="tier-model-row">
          <a class:list={["tier-model-thumb", "handpiece-model-thumb", "air-model-thumb", { "air-model-thumb-standard": !originalCoverSlugs.has(model.slug) }]} href={detailHref(model.slug)} aria-label={`View ${model.model} details`}>{model.thumbnail ? <img src={coverOverrides[model.slug] || model.thumbnail} alt={`${model.model} dental air equipment photo`} width="112" height="86" loading="lazy" decoding="async" /> : <span class="air-photo-pending">Photo pending</span>}</a>
          <div class="tier-model-meta"><a class="tier-model-name" href={detailHref(model.slug)}>{model.model}</a><p>{model.summary}</p></div>
          <div class="tier-model-actions"><a class="tier-model-details" href={detailHref(model.slug)}>Details <span aria-hidden="true">→</span></a><a class="tier-model-inquiry" href={inquiryHref(model.model)}>Inquiry</a></div>
        </article>)}
      </div>
    </section>)}
  </div></section>
  <InquiryCta lang={lang} title="Request Air Equipment Details" />
</BaseLayout>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>("[data-air-tab]")];
  const panels = [...document.querySelectorAll<HTMLElement>("[data-air-panel]")];
  const activate = (id: string, focus = false) => {
    const selected = tabs.find((tab) => tab.dataset.group === id);
    if (!selected) return;
    tabs.forEach((tab) => {
      const active = tab === selected;
      tab.setAttribute("aria-selected", String(active));
      tab.tabIndex = active ? 0 : -1;
    });
    panels.forEach((panel) => { panel.hidden = panel.dataset.group !== id; });
    if (focus) selected.focus();
  };
  tabs.forEach((tab, index) => {
    tab.addEventListener("click", () => { activate(tab.dataset.group || ""); history.replaceState(null, "", `#${tab.dataset.group}`); });
    tab.addEventListener("keydown", (event) => {
      const next = event.key === "ArrowRight" ? (index + 1) % tabs.length : event.key === "ArrowLeft" ? (index - 1 + tabs.length) % tabs.length : event.key === "Home" ? 0 : event.key === "End" ? tabs.length - 1 : -1;
      if (next < 0) return;
      event.preventDefault();
      const id = tabs[next].dataset.group || "";
      activate(id, true);
      history.replaceState(null, "", `#${id}`);
    });
  });
  activate(location.hash.slice(1));
  window.addEventListener("hashchange", () => activate(location.hash.slice(1)));
</script>

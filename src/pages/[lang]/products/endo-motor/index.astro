---
import BaseLayout from "@components/layout/BaseLayout.astro";
import Button from "@components/ui/Button.astro";
import InquiryCta from "@components/ui/InquiryCta.astro";
import catalog from "@data/endoMotorModels.json";
import { getLanguage, languages, localizedPath } from "@lib/i18n";

export function getStaticPaths() {
  return languages.map((language) => ({ params: { lang: language.code } }));
}

const lang = getLanguage(Astro.params.lang);
const detailHref = (slug: string) => localizedPath(lang, `/products/endo-motor/${slug}/`);
const inquiryHref = (model: string) => localizedPath(lang, `/contact/?message=${encodeURIComponent(`I'm interested in the ${model} endodontic motor.`)}`);
---
<BaseLayout title="Endo Motor — ENDOMOTOR X and Y-SMART" description="Explore ENDOMOTOR X and Y-SMART cordless endodontic motors for root canal preparation." lang={lang} pathname={Astro.url.pathname}>
  <section class="chair-tier-hero">
    <div class="container">
      <nav class="chair-tier-breadcrumb" aria-label="Breadcrumb">
        <a href={localizedPath(lang, "/products/")}>Products</a><span aria-hidden="true">/</span>
        <span aria-current="page">Endo Motor</span>
      </nav>
      <p class="chair-tier-eyebrow">Endodontic Equipment</p>
      <h1>Endo Motor</h1>
      <p class="chair-tier-summary">Cordless motors for controlled root canal preparation. Explore the two available models.</p>
      <Button href={localizedPath(lang, "/contact/?category=endo-motor")}>Ask for Quote</Button>
    </div>
  </section>
  <section class="chair-tier-models" id="models">
    <div class="container">
      <div class="tier-model-groups">
        <section class="tier-model-group" aria-labelledby="endo-models-title">
          <header class="tier-group-head"><h2 id="endo-models-title">Available Models</h2><span class="tier-group-count">2 models</span><span class="tier-group-rule" aria-hidden="true"></span></header>
          <div class="tier-group-rows">
            {catalog.map((model) => <article class="tier-model-row">
              <a class="tier-model-thumb handpiece-model-thumb" href={detailHref(model.slug)} aria-label={`View ${model.model} details`}><img src={model.thumbnail} alt={`${model.model} endodontic motor photo`} width="112" height="86" loading="lazy" decoding="async" /></a>
              <div class="tier-model-meta"><a class="tier-model-name" href={detailHref(model.slug)}>{model.model}</a><p>{model.subtitle}</p></div>
              <div class="tier-model-actions"><a class="tier-model-details" href={detailHref(model.slug)}>Details <span aria-hidden="true">→</span></a><a class="tier-model-inquiry" href={inquiryHref(model.model)}>Inquiry</a></div>
            </article>)}
          </div>
        </section>
      </div>
    </div>
  </section>
  <InquiryCta lang={lang} title="Request Endo Motor Details" />
</BaseLayout>
